  <script>
    const form = document.getElementById("contact-form");
    const submitButton = document.getElementById("submit-button");
    const statusBox = document.getElementById("form-status");
    let sdkReady = false;

    function showStatus(message, type) {
      statusBox.textContent = message;
      statusBox.className = "rounded-xl px-4 py-3 text-sm font-semibold";
      statusBox.classList.add(type === "success" ? "bg-emerald-100" : "bg-red-100");
      statusBox.classList.add(type === "success" ? "text-emerald-800" : "text-red-800");
    }

    async function initializeSheet() {
      try {
        const result = await window.dataSdk.init({
          onDataChanged() {}
        });
        sdkReady = result.isOk;
        if (!result.isOk) showStatus("Formulir belum siap. Silakan coba lagi beberapa saat.", "error");
      } catch {
        sdkReady = false;
        showStatus("Formulir belum dapat terhubung. Silakan muat ulang halaman.", "error");
      }
    }

    form.addEventListener("submit", async function(event) {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!sdkReady) {
        showStatus("Formulir belum siap. Silakan coba lagi beberapa saat.", "error");
        return;
      }

      submitButton.disabled = true;
      submitButton.classList.add("opacity-70", "cursor-not-allowed");

      try {
        const result = await window.dataSdk.create({
          nama: document.getElementById("nama").value.trim(),
          email: document.getElementById("email").value.trim(),
          pesan: document.getElementById("pesan").value.trim(),
          tanggal: new Date().toISOString()
        });

        if (!result.isOk) {
          showStatus("Pesan belum dapat dikonfirmasi. Silakan coba lagi nanti.", "error");
          return;
        }

        form.reset();
        showStatus("Terima kasih. Pesan Anda telah berhasil dikirim ke sekolah.", "success");
      } catch {
        showStatus("Terjadi kendala saat mengirim pesan. Silakan coba lagi.", "error");
      } finally {
        submitButton.disabled = false;
        submitButton.classList.remove("opacity-70", "cursor-not-allowed");
      }
    });

    document.addEventListener("DOMContentLoaded", function() {
      lucide.createIcons();
      initializeSheet();
    });
  </script>
 
